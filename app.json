{
  "expo": {
    "name": "Cookie",
    "slug": "Cookie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.randyrandyworld.cookie",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF7E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.randyrandyworld.cookie",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "주변 사람과의 거리를 보여주기 위해 위치 권한이 필요해요."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진을 등록하려면 사진 보관함 접근이 필요해요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E8602C"
        }
      ]
    ],
    "scheme": "cookie",
    "extra": {
      "eas": {
        "projectId": "a334b386-e689-426e-bd16-df5f144175e8"
      }
    },
    "owner": "randykims-team"
  }
}
