rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────── 공통 도우미 ─────────
    function signedIn() {
      return request.auth != null;
    }

    // ⚠️ 관리자 UID — src/adminConfig.js 의 ADMIN_UIDS 와 항상 같아야 해요
    function isAdmin() {
      return signedIn() && request.auth.uid in [
        "0oQnnfN9OlMtHhkotmctVkeRAMr2",
        "J616YkESF8PQRowNvxTwENgtPio2"
      ];
    }

    // 매치 id("uidA_uidB")에 내 uid가 들어있는지 = 이 매치의 당사자인지
    function inMatch(matchId) {
      return signedIn() && request.auth.uid in matchId.split('_');
    }

    // 관리자의 더미 테스트용 매치/채팅 (id에 dummy_ 포함)
    function adminDummyMatch(matchId) {
      return isAdmin() && matchId.matches('.*dummy_.*');
    }

    // a가 b에게 좋아요를 눌렀는지 (swipes/a/actions/b.liked == true)
    function likedBy(a, b) {
      return get(/databases/$(database)/documents/swipes/$(a)/actions/$(b)).data.liked == true;
    }

    // 차단/매칭끊기 되지 않은 열린 대화인지
    function matchOpen(matchId) {
      let m = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return m.get('blockedBy', []).size() == 0 && m.get('unmatchedBy', []).size() == 0;
    }

    // ───────── 유저 프로필 ─────────
    match /users/{userId} {
      allow read: if signedIn();

      // 관리자는 더미 생성/삭제·테스트 충전 등 모두 가능
      allow write: if isAdmin();

      // 가입: 본인 문서, 가입 보너스 쿠키 30개로만 시작, 조작 가능한 보호 필드는 비어 있어야 함
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.cookies == 30
        && !('reportedBy' in request.resource.data)
        && !('isDummy' in request.resource.data)
        && !('boostedUntil' in request.resource.data)
        && !('likesUsedToday' in request.resource.data)
        && !('lastFreeSuperLikeAt' in request.resource.data)
        && request.resource.data.birthDate is string
        && request.resource.data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');

      // 본인 문서 수정
      allow update: if signedIn()
        && request.auth.uid == userId
        && (
          // 쿠키는 "줄이는 것"만 가능 (쓰는 건 되고, 늘리는 건 서버/관리자만)
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['cookies'])
          || (request.resource.data.cookies is number
              && request.resource.data.cookies >= 0
              && request.resource.data.cookies < resource.data.get('cookies', 0))
        )
        && (
          // 부스트는 쿠키 10개 이상을 차감하는 같은 쓰기에서만, 최대 30분(+여유)까지
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['boostedUntil'])
          || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['cookies'])
              && resource.data.get('cookies', 0) - request.resource.data.cookies >= 10
              && request.resource.data.boostedUntil <= request.time.toMillis() + 2700000)
        )
        && (
          // 하루 좋아요 카운트는 같은 날 안에서 줄일 수 없음
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['likesUsedToday', 'likesDate'])
          || request.resource.data.get('likesDate', '') != resource.data.get('likesDate', '')
          || request.resource.data.get('likesUsedToday', 0) >= resource.data.get('likesUsedToday', 0)
        )
        && (
          // 무료 슈퍼라이크: 서버 시각으로만 기록 + 3일(71시간 이상) 쿨다운
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastFreeSuperLikeAt'])
          || (request.resource.data.lastFreeSuperLikeAt == request.time
              && (resource.data.get('lastFreeSuperLikeAt', null) == null
                  || request.time > resource.data.lastFreeSuperLikeAt + duration.value(71, 'h')))
        )
        // 신고 기록·더미 표시·가입일은 본인이 못 건드림
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reportedBy', 'isDummy', 'createdAt'])
        // 생년월일·성별·키는 한 번 정하면 변경 불가 (아직 없는 기존 계정은 한 번 입력 가능)
        && (!('birthDate' in resource.data)
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['birthDate']))
        && (!('gender' in resource.data)
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['gender']))
        && (!('height' in resource.data)
            || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['height']));

      // 다른 사람이 나를 신고: reportedBy 에 자기 uid를 한 번 추가하는 것만 허용
      allow update: if signedIn()
        && request.auth.uid != userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportedBy'])
        && request.auth.uid in request.resource.data.reportedBy
        && request.resource.data.reportedBy.size() == resource.data.get('reportedBy', []).size() + 1;

      // 계정 삭제는 서버 기능이 생기기 전까지 관리자만 (삭제 후 재가입으로 가입 보너스를 반복해서 받는 것 방지)
    }

    // ───────── 스와이프 기록 ─────────
    match /swipes/{uid}/actions/{target} {
      // 내 기록은 내가. 상대가 나를 "좋아요" 한 기록만 나도 확인 가능(매칭 판정용), "패스"는 절대 안 보임
      allow get: if signedIn()
        && (request.auth.uid == uid
            || (request.auth.uid == target
                && (resource == null || resource.data.liked == true)));
      allow list: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && uid != target
        && request.resource.data.keys().hasOnly(['liked', 'isSuper', 'at'])
        && request.resource.data.liked is bool;
      allow write: if isAdmin();
    }

    // ───────── 날 좋아요한 사람 ─────────
    match /likesReceived/{receiver}/from/{sender} {
      allow read: if signedIn() && request.auth.uid == receiver;
      // 실제로 내가 그 사람을 좋아요 한 기록이 있어야만 만들 수 있음
      allow create, update: if signedIn()
        && request.auth.uid == sender
        && sender != receiver
        && request.resource.data.keys().hasOnly(['at', 'isSuper'])
        && likedBy(sender, receiver);
      allow write: if isAdmin();
    }

    // ───────── 매칭 ─────────
    match /matches/{matchId} {
      allow get: if inMatch(matchId) || adminDummyMatch(matchId);
      allow list: if signedIn() && request.auth.uid in resource.data.users;

      // 서로 좋아요 한 두 사람 사이에서만, 정렬된 id로만 생성 가능
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['users', 'createdAt', 'lastMessage', 'lastMessageAt'])
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] != request.resource.data.users[1]
        && request.auth.uid in request.resource.data.users
        && (request.resource.data.users[0] < request.resource.data.users[1]
              ? matchId == request.resource.data.users[0] + '_' + request.resource.data.users[1]
              : matchId == request.resource.data.users[1] + '_' + request.resource.data.users[0])
        && likedBy(request.resource.data.users[0], request.resource.data.users[1])
        && likedBy(request.resource.data.users[1], request.resource.data.users[0]);

      // 당사자만, 마지막 메시지/읽음/차단/매칭끊기 필드만. 차단·끊기는 "내 uid 추가"만 가능(남이 한 걸 되돌릴 수 없음)
      allow update: if inMatch(matchId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['lastMessage', 'lastMessageAt', 'lastSenderId', 'blockedBy', 'unmatchedBy', 'lastRead_' + request.auth.uid])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSenderId'])
            || request.resource.data.lastSenderId == request.auth.uid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['blockedBy'])
            || (request.resource.data.blockedBy.hasAll(resource.data.get('blockedBy', []))
                && request.resource.data.blockedBy.toSet().difference(resource.data.get('blockedBy', []).toSet()).hasOnly([request.auth.uid])))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['unmatchedBy'])
            || (request.resource.data.unmatchedBy.hasAll(resource.data.get('unmatchedBy', []))
                && request.resource.data.unmatchedBy.toSet().difference(resource.data.get('unmatchedBy', []).toSet()).hasOnly([request.auth.uid])));

      allow write: if adminDummyMatch(matchId);

      // ───────── 채팅 메시지 ─────────
      match /messages/{msgId} {
        allow read: if inMatch(matchId) || adminDummyMatch(matchId);
        // 당사자만, 본인 이름으로, 1000자 이내, 서버 시각으로, 열린 대화에서만
        allow create: if inMatch(matchId)
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time
          && matchOpen(matchId);
        allow write: if adminDummyMatch(matchId);
      }
    }

    // ───────── 차단 목록 (본인만) ─────────
    match /blocks/{uid}/blocked/{target} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ───────── 신고 (쓰기 전용, 읽기는 관리자만) ─────────
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasOnly(['reporterId', 'targetId', 'reason', 'createdAt'])
        && request.resource.data.targetId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 100;
      allow read: if isAdmin();
    }
  }
}
